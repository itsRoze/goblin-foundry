{
  "name": "@goblin/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./zero": "./src/zero.ts",
    "./sql": "./src/sql.ts",
    "./queries": "./src/queries.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "@rocicorp/zero": "^1.9.0",
    "zod": "^4.4.3",
    "postgres": "^3.4.7"
  }
}
