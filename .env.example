# Copy to .env and adjust. Never commit .env.

# --- Postgres (docker compose, infra/docker-compose.yml) ---
PG_URL=postgresql://goblin:goblin@127.0.0.1:6432/factory
ZERO_UPSTREAM_DB=postgresql://goblin:goblin@127.0.0.1:6432/factory
ZERO_CVR_DB=postgresql://goblin:goblin@127.0.0.1:6432/zero_cvr
ZERO_CHANGE_DB=postgresql://goblin:goblin@127.0.0.1:6432/zero_change
ZERO_REPLICA_FILE=./var/zero-replica.db

# --- Ports ---
API_PORT=4848
ZERO_PORT=4849
WEB_PORT=5173

# --- Single-user auth (M0): one shared token for web + skills + MCP later ---
FOUNDRY_TOKEN=change-me

# --- Claude auth for the worker ---
# `claude setup-token` mints a one-year subscription token (preferred).
# CLAUDE_CODE_OAUTH_TOKEN=
# Per-phase failover when the plan window is exhausted.
# ANTHROPIC_API_KEY=
