exports[`the lifecycle, pinned every edge, in table order 1`] = `
[
  "backlog -pick-> todo human",
  "planning -pick-> todo human",
  "backlog -plan-> planning human",
  "todo -plan-> planning human",
  "todo -shelve-> backlog human",
  "planning -shelve-> backlog human",
  "todo -approve-> ready human guarded",
  "planning -approve-> ready human guarded",
  "ready -unapprove-> planning human",
  "ready -start-> building human",
  "building -stop-> ready human",
  "building -submit-> review human",
  "review -ship-> done human",
  "backlog -close-> done human",
  "todo -close-> done human",
  "planning -close-> done human",
  "ready -close-> done human",
  "building -close-> done human",
  "backlog -cancel-> cancelled human",
  "todo -cancel-> cancelled human",
  "planning -cancel-> cancelled human",
  "ready -cancel-> cancelled human",
  "building -cancel-> cancelled human",
  "review -cancel-> cancelled human",
  "done -cancel-> cancelled human",
  "cancelled -reopen-> backlog human",
]
`;

